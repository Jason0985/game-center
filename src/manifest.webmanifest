{
  "name": "Game Center",
  "short_name": "Game Center",
  "description": "Spieleabende mit Freunden: Uno, Skip-Bo und Flip 7 online spielen, Ranglisten führen und praktische Werkzeuge wie Ankunftsplaner und F1-Strategie.",
  "lang": "de",
  "categories": ["games", "entertainment"],
  "theme_color": "#1c1c1e",
  "background_color": "#1c1c1e",
  "display": "standalone",
  "id": "/game-center/",
  "scope": "/game-center/",
  "start_url": "/game-center/",
  "apple-mobile-web-app-capable": "yes",
  "apple-mobile-web-app-title": "Game Center",
  "apple-mobile-web-app-status-bar-style": "default",
  "shortcuts": [
    {
      "name": "Online spielen",
      "short_name": "Spielen",
      "description": "Lobby eröffnen oder mit Code beitreten",
      "url": "/game-center/multiplayer",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Statistik",
      "short_name": "Statistik",
      "description": "Siege, Serien und letzte Spiele",
      "url": "/game-center/profile/stats",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ankunftsplaner",
      "short_name": "Wecker",
      "description": "Weckzeit für deine Ankunft berechnen",
      "url": "/game-center/collection/arrival-planner",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
