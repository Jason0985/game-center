{
  "name": "Game Center",
  "short_name": "Game Center",
  "theme_color": "#0f1115",
  "background_color": "#0f1115",
  "display": "standalone",
  "id": "/game-center/",
  "scope": "/game-center/",
  "start_url": "/game-center/",
  "apple-mobile-web-app-capable": "yes",
  "apple-mobile-web-app-title": "Game Center",
  "apple-mobile-web-app-status-bar-style": "default",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
